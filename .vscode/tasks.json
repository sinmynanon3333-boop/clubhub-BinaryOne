{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --build --preset default",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build and run",
      "type": "shell",
      "command": ".\\build\\app.exe",
